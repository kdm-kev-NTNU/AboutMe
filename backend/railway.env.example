# Railway backend service variables (set in Railway dashboard or `railway variables set`).
# Copy values into Railway; do not commit real secrets.

# Required for production profile
SPRING_PROFILES_ACTIVE=prod

# Session cookie JWT (min 32 chars; ProdStartupValidator enforces)
PORTFOLIO_JWT_SECRET=

# AI budget anonymous identity (must not be default portfolio-ai-budget)
AI_BUDGET_ANON_SALT=

# OpenAI (required for chat, embeddings, ingest)
OPENAI_API_KEY=
OPENAI_CHAT_ENABLED=true

# First admin only — clear ADMIN_BOOTSTRAP_PASSWORD after first successful login
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=

# Optional: explicit JDBC (otherwise use linked Postgres PGHOST/PGPORT/PGDATABASE/PGUSER/PGPASSWORD)
# SPRING_DATASOURCE_URL=
# SPRING_DATASOURCE_USERNAME=
# SPRING_DATASOURCE_PASSWORD=

# Optional
# ANTHROPIC_API_KEY=
# PORTFOLIO_REALTIME_ENABLED=true
# POSTHOG_ENABLED=false
# POSTHOG_API_KEY=
