<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0
                              https://maven.apache.org/xsd/settings-1.2.0.xsd">

  <!--
    The philterd repo is declared here (instead of pom.xml) so that Maven
    resolves standard dependencies from Central first and only falls back
    to artifacts.philterd.ai for ai.philterd:phileas-core and its
    transitive deps.  Declaring it in pom.xml caused Maven to try the
    slow philterd server for every single artifact before Central.
  -->
  <profiles>
    <profile>
      <id>philterd</id>
      <repositories>
        <repository>
          <id>philterd-repository-releases</id>
          <url>https://artifacts.philterd.ai/releases</url>
          <releases><enabled>true</enabled></releases>
          <snapshots><enabled>false</enabled></snapshots>
        </repository>
      </repositories>
    </profile>
  </profiles>

  <activeProfiles>
    <activeProfile>philterd</activeProfile>
  </activeProfiles>

</settings>
