# Copy to .env in repo root. Do not commit real values.
# Defaults for everything else live in backend/src/main/resources/application.yaml.

# --- Required for OpenAI chat / RAG (set both) ---
OPENAI_API_KEY=
# Must be true when using OpenAI chat; false skips OpenAI chat autoconfig so the app can start without a key.
OPENAI_CHAT_ENABLED=true

# --- Optional: additional LLM provider ---
# ANTHROPIC_API_KEY=

# --- Optional: database ---
# Local: defaults to localhost:5432/aboutme / postgres (see application.yaml).
# docker-compose overrides JDBC to host `db` via SPRING_DATASOURCE_* in compose.
# Railway: link Postgres → PGHOST, PGPORT, PGDATABASE, PGUSER, PGPASSWORD (no .env needed), or set SPRING_DATASOURCE_*.
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/aboutme
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=postgres

# --- Optional: PostHog analytics ---
# POSTHOG_ENABLED=false
# POSTHOG_API_KEY=
# POSTHOG_HOST=https://eu.i.posthog.com
# VITE_POSTHOG_ENABLED=false
# VITE_POSTHOG_KEY=
# VITE_POSTHOG_HOST=https://eu.i.posthog.com

# --- Optional: bootstrap first admin user ---
# ADMIN_BOOTSTRAP_USERNAME=
# ADMIN_BOOTSTRAP_PASSWORD=

# --- Optional: production profile (Railway) ---
# SPRING_PROFILES_ACTIVE=prod
