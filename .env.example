# Backend secrets (repo root): copy to .env at the repository root. Do not commit real values.
# Frontend build-time VITE_* values: see frontend/homepage/.env.example
# Docker Compose Postgres credentials: copy .env.docker.example to .env.docker (repo root).
# Defaults for everything else live in backend/src/main/resources/application.yaml.
# Migration: if you still have backend/.env, move its contents here and delete backend/.env.
# --- Required for OpenAI chat / RAG (set both) ---
OPENAI_API_KEY=
# Must be true when using OpenAI chat; false skips OpenAI chat autoconfig so the app can start without a key.
OPENAI_CHAT_ENABLED=true
# Live voice (OpenAI Realtime WebRTC). Requires OPENAI_API_KEY. Default off in application.yaml.
# Defaults use gpt-realtime-2 with marin voice and low reasoning effort for fluid voice-agent conversations.
# PORTFOLIO_REALTIME_ENABLED=true
# PORTFOLIO_REALTIME_MODEL=gpt-realtime-2
# PORTFOLIO_REALTIME_VOICE=marin
# PORTFOLIO_REALTIME_REASONING_EFFORT=low
# Optional provider catalog for /voice. OpenAI provider is enabled by default when OPENAI_API_KEY is set.
# PORTFOLIO_REALTIME_OPENAI_ENABLED=true
# ElevenLabs Conversational AI voice agents (requires PORTFOLIO_REALTIME_ENABLED=true).
# PORTFOLIO_REALTIME_ELEVENLABS_ENABLED=false
# ELEVENLABS_API_KEY=
# ELEVENLABS_AGENT_ID=
# ELEVENLABS_AGENT_LABEL=ElevenLabs Agent
# ELEVENLABS_AGENT_ENVIRONMENT=production
# ELEVENLABS_AGENT_BRANCH_ID=

# --- Optional: additional LLM provider ---
# ANTHROPIC_API_KEY=

# --- Optional: chat default model (allow-listed ids; see application.yaml portfolio.chat) ---
# PORTFOLIO_CHAT_DEFAULT_MODEL_ID=gpt-5.4-mini

# --- Optional: OpenNLP / sanitizer pipeline (docker-compose sets true for backend) ---
# SANITIZER_ENABLED=true

# --- Optional: AI budget anonymous identity salt (production: set a stable secret) ---
# AI_BUDGET_ANON_SALT=

# --- Optional: database ---
# Local: defaults to localhost:5432/aboutme / postgres (see application.yaml).
# docker-compose overrides JDBC to host `db` via SPRING_DATASOURCE_* in compose.
# Railway: link Postgres â†’ PGHOST, PGPORT, PGDATABASE, PGUSER, PGPASSWORD (no .env needed), or set SPRING_DATASOURCE_*.
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/aboutme
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=postgres

# --- Optional: PostHog analytics ---
# Backend (backend/.env): POSTHOG_* below. Frontend Vite keys belong in frontend/homepage/.env for local dev and Docker build.
# POSTHOG_ENABLED=false
# POSTHOG_API_KEY=
# POSTHOG_HOST=https://eu.i.posthog.com
# For REST/MCP-style setup of LLM evaluations (not used by Spring at runtime), set in your shell or CI:
# POSTHOG_PERSONAL_API_KEY=   # Personal API key (not the same as POSTHOG_API_KEY)
# POSTHOG_PROJECT_ID=         # Numeric project id from PostHog project settings
# POSTHOG_APP_HOST=https://eu.posthog.com   # optional; derived from POSTHOG_HOST when omitted
# (frontend/homepage/.env) VITE_POSTHOG_ENABLED=false
# (frontend/homepage/.env) VITE_POSTHOG_KEY=
# (frontend/homepage/.env) VITE_POSTHOG_HOST=https://eu.i.posthog.com

# --- Optional: bootstrap first admin user ---
# ADMIN_BOOTSTRAP_USERNAME=
# ADMIN_BOOTSTRAP_PASSWORD=

# --- Optional: vector_store sync (Railway â†’ local backend only) ---
# Enable POST /admin/tools/documents/sync-from-remote on your local API (never enable on public Railway).
# SYNC_ENABLED=true
# SYNC_SOURCE_URL=jdbc:postgresql://<railway-host>:<port>/<database>
# SYNC_SOURCE_USERNAME=postgres
# SYNC_SOURCE_PASSWORD=<password>
# CLI alternative: scripts/sync-from-railway.ps1 / sync-from-railway.sh with RAILWAY_PG* env vars.

# --- Optional: production profile (Railway) ---
# SPRING_PROFILES_ACTIVE=prod