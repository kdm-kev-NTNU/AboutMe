# Copy to `.env` in the repo root or to `backend/.env`.
# Spring Boot loads optional env files from those paths (see spring.config.import in
# backend/src/main/resources/application.yaml). Never commit real secrets.

# --- Required (local dev with docker-compose MySQL on 3307) ---
# OpenAI is used for embeddings / Chroma RAG retrieval (text-embedding-3-large) and optionally for chat.
OPENAI_API_KEY=
# Optional: enables Anthropic Claude models in the chat UI. Embeddings still use OpenAI above.
ANTHROPIC_API_KEY=
# HTTP port for Spring Boot (docker-compose `backend` sets 8080).
PORT=8080
# Same names Railway uses for MySQL (Spring relaxed binding).
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root

# --- Optional: override JDBC URL (docker-compose `backend` service sets this to db:3306) ---
# SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3307/aboutme?useSSL=false&allowPublicKeyRetrieval=true

# --- Optional: ChromaDB HTTP client (defaults match docker-compose port mapping) ---
# CHROMA_HTTP_HOST=http://localhost
# CHROMA_PORT=8100
# CHROMA_COLLECTION=portfolio-documents
# Set to false when Chroma is not deployed (chat works without RAG; admin document APIs return 501).
# CHROMA_ENABLED=false
# Railway: if Chroma uses private networking and the Java backend gets I/O errors, bind Chroma to IPv6, e.g.:
# CHROMA_HOST_ADDR=::

# --- Optional: OTLP tracing (Spring Boot management.otlp; gRPC). Default matches local Phoenix in docker-compose (4317). ---
# Local Phoenix on host: http://localhost:4317
# Inside docker-compose backend service this is set to http://phoenix:4317
# PHOENIX_OTLP_ENDPOINT=http://localhost:4317

# --- Optional: Phoenix REST (datasets / experiments UI). HTTP UI is usually port 6006 (not 4317 OTLP). ---
# Local: PHOENIX_BASE_URL=http://localhost:6006
# Railway / cloud Phoenix: set base URL and same PHOENIX_API_KEY as OTLP if required.
# PHOENIX_BASE_URL=http://localhost:6006

# --- Optional: PostHog (frontend analytics; consented + anonymous only) ---
# VITE_POSTHOG_ENABLED=false
# VITE_POSTHOG_KEY=
# VITE_POSTHOG_HOST=https://eu.i.posthog.com

# --- Optional: default chat model when POST /ask omits "model" (Spring: portfolio.chat.default-model-id) ---
# PORTFOLIO_CHAT_DEFAULT_MODEL_ID=gpt-5.4-mini

# --- Optional: first-time admin (only if username does not exist yet). Remove ADMIN_BOOTSTRAP_PASSWORD after login. ---
# ADMIN_BOOTSTRAP_USERNAME=
# ADMIN_BOOTSTRAP_PASSWORD=

# --- Optional: dev tooling (not read by Spring). Used by `npm run api:pull` in frontend/homepage; default http://localhost:8080/v3/api-docs ---
# OPENAPI_URL=http://localhost:8080/v3/api-docs
