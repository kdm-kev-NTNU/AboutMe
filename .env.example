# Kopier til backend/.env og fyll inn. Ikke commit ekte nøkler.
# Spring Boot importerer optional: backend/.env, ./.env eller repo-root .env — se application.yaml.
#
# Prompts, RAG-maler og realtime-profil: backend/src/main/resources/ (FILES.example).
# Frontend portfolio-JSON: frontend/homepage/src/types/*.json
#
# --- Database ---
# Full JDBC-URL (overstyrer PG* nedenfor):
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/aboutme
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=postgres
# Alternativ (f.eks. Railway Postgres uten full JDBC-URL):
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=aboutme
# PGUSER=postgres
# PGPASSWORD=postgres

# --- Server ---
# PORT=8080
# SPRING_PROFILES_ACTIVE=prod

# --- OpenAI / chat (påkrevd for chat og RAG) ---
OPENAI_API_KEY=
# Samme nøkkel, annet navn (Spring AI-kompatibel fallback):
# SPRING_AI_OPENAI_API_KEY=
OPENAI_CHAT_ENABLED=true

# --- Anthropic (valgfritt) ---
# ANTHROPIC_API_KEY=

# --- AI-budsjett (anonym hashing — endre i prod) ---
# AI_BUDGET_ANON_SALT=portfolio-ai-budget

# --- Realtime stemme (OpenAI Realtime + ElevenLabs) ---
# PORTFOLIO_REALTIME_ENABLED=true
# PORTFOLIO_REALTIME_MODEL=gpt-realtime-2
# PORTFOLIO_REALTIME_VOICE=marin
# PORTFOLIO_REALTIME_REASONING_EFFORT=low
# PORTFOLIO_REALTIME_OPENAI_ENABLED=true

# ElevenLabs ConvAI — Agents-URL: .../agents/agent_<AGENT_ID>?branchId=<BRANCH_ID>
# PORTFOLIO_REALTIME_ELEVENLABS_ENABLED=true
# ELEVENLABS_API_KEY=
# ELEVENLABS_AGENT_ID=agent_3201kr8t7mnzfpta4svtbqzmafa1
# ELEVENLABS_AGENT_BRANCH_ID=agtbrch_2201kr8t7mzheqttmnezkakxk9pq
# ELEVENLABS_AGENT_LABEL=Kevin's AI
# ELEVENLABS_AGENT_ENVIRONMENT=

# --- PostHog (serverside feature flags / backend) ---
# POSTHOG_ENABLED=false
# POSTHOG_API_KEY=
# POSTHOG_HOST=https://eu.i.posthog.com

# --- PII-sanitizer for chat ---
# SANITIZER_ENABLED=true

# --- Vektorsynk fra ekstern Postgres (dev/debug) ---
# SYNC_ENABLED=false
# SYNC_SOURCE_URL=
# SYNC_SOURCE_USERNAME=
# SYNC_SOURCE_PASSWORD=

# --- Admin (opprett én admin ved første oppstart; fjern passord etterpå i prod) ---
# ADMIN_BOOTSTRAP_USERNAME=
# ADMIN_BOOTSTRAP_PASSWORD=

# =============================================================================
# Frontend (Vite): kopier relevante linjer til frontend/homepage/.env
# (brukes ved docker build / npm run build — se docker-compose.yml).
# =============================================================================
# VITE_POSTHOG_ENABLED=false
# VITE_POSTHOG_KEY=
# VITE_POSTHOG_HOST=https://eu.i.posthog.com
