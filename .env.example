# Copy to `.env` in the repo root or `backend/`. Spring loads these via `spring.config.import`
# in backend/src/main/resources/application.yaml. Do not commit real values.
#
# --- Local (PC): typical workflow ---
# 1) Copy this file to `.env` at repo root (or `backend/.env`).
# 2) Fill OPENAI_API_KEY and (if you use Compose) datasource defaults below.
# 3) Optional: enable ONNX rerank and point to exported model.onnx + tokenizer folder.
#
# --- Railway ---
# Set the same variable *names* in Railway: your service → Variables (no `.env` file is deployed).
# Use `SPRING_PROFILES_ACTIVE=prod` so production logging/Swagger overrides apply (see application-prod.yaml).
# The backend Docker image (backend/Dockerfile) bundles ONNX rerank under /app/rerank and sets
# PORTFOLIO_RETRIEVAL_* defaults there with rerank enabled. Override in Railway if needed, e.g.
# PORTFOLIO_RETRIEVAL_RERANK_ENABLED=false to turn reranking off.

# --- Required (typical local dev: Compose Postgres on 5432) ---
# OpenAI: embeddings + RAG. Keep embedding model/dimensions aligned with pgvector (see application.yaml).
OPENAI_API_KEY=
# Optional: Anthropic Claude in the chat UI; embeddings still use OpenAI above.
ANTHROPIC_API_KEY=
PORT=8080
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# --- Optional: JDBC ---
# Local Compose (default in application.yaml points at localhost:5432/aboutme):
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/aboutme
# Railway Postgres: use the JDBC URL from the database service (host/port/db/user/password), e.g.:
# SPRING_DATASOURCE_URL=jdbc:postgresql://${PGHOST}:${PGPORT}/${PGDATABASE}
# SPRING_DATASOURCE_USERNAME=${PGUSER}
# SPRING_DATASOURCE_PASSWORD=${PGPASSWORD}

# --- Optional: Spring profile (use on Railway) ---
# SPRING_PROFILES_ACTIVE=prod

# --- Optional: Phoenix / OTLP (gRPC, often :4317) vs REST UI (often :6006) ---
# Host vs in-Compose URLs differ (e.g. localhost vs phoenix). In cloud, REST base URL and OTLP
# endpoint may need different hostnames; set PHOENIX_API_KEY for REST + OTLP when required.
# PHOENIX_OTLP_ENDPOINT=http://localhost:4317
# PHOENIX_BASE_URL=http://localhost:6006
# PHOENIX_API_KEY=

# --- Optional: PostHog (anonymous, consented frontend; optional backend LLM events) ---
# Use one project per deployment. Frontend: VITE_* ; backend: POSTHOG_* (see Spring config).
# VITE_POSTHOG_ENABLED=false
# VITE_POSTHOG_KEY=
# VITE_POSTHOG_HOST=https://eu.i.posthog.com
# POSTHOG_ENABLED=false
# POSTHOG_API_KEY=
# POSTHOG_HOST=https://eu.i.posthog.com

# --- Optional: default model when POST /ask omits "model" ---
# PORTFOLIO_CHAT_DEFAULT_MODEL_ID=gpt-5.4-mini

# --- Optional: RAG retrieval + local ONNX cross-encoder rerank (portfolio.retrieval.*) ---
# application.yaml defaults: 40 vector hits, 40 candidates, 40 in prompt, rerank off (local `mvn` without ONNX files).
# When you run the built backend Docker image, rerank defaults ON with model at /app/rerank (see backend/Dockerfile ENV).
#
# Local Windows example (Optimum export: model.onnx + tokenizer.json in one folder):
# PORTFOLIO_RETRIEVAL_RERANK_ENABLED=true
# PORTFOLIO_RETRIEVAL_ONNX_MODEL_PATH=C:/models/cross-encoder/model.onnx
# PORTFOLIO_RETRIEVAL_TOKENIZER_PATH=C:/models/cross-encoder
#
# Local macOS/Linux example:
# PORTFOLIO_RETRIEVAL_RERANK_ENABLED=true
# PORTFOLIO_RETRIEVAL_ONNX_MODEL_PATH=/home/you/models/cross-encoder/model.onnx
# PORTFOLIO_RETRIEVAL_TOKENIZER_PATH=/home/you/models/cross-encoder
#
# Wide retrieve → rerank → narrow context (when rerank is enabled):
# PORTFOLIO_RETRIEVAL_VECTOR_TOP_K=80
# PORTFOLIO_RETRIEVAL_CANDIDATE_LIMIT=120
# PORTFOLIO_RETRIEVAL_CONTEXT_TOP_K=12
#
# Tunables (same locally and on Railway):
# PORTFOLIO_RETRIEVAL_RERANK_BATCH_SIZE=8
# PORTFOLIO_RETRIEVAL_MAX_PASSAGE_CHARS=2000
# PORTFOLIO_RETRIEVAL_MAX_SEQUENCE_LENGTH=256
#
# Railway (Docker deploy): paths are pre-set in the image; only add vars to override, e.g. wider retrieval:
# PORTFOLIO_RETRIEVAL_VECTOR_TOP_K=80
# PORTFOLIO_RETRIEVAL_CANDIDATE_LIMIT=120
# PORTFOLIO_RETRIEVAL_CONTEXT_TOP_K=12

# --- Optional: first admin if username missing (remove password after login) ---
# ADMIN_BOOTSTRAP_USERNAME=
# ADMIN_BOOTSTRAP_PASSWORD=

# --- Optional: Orval `npm run api:pull` (not read by Spring) ---
# OPENAPI_URL=http://localhost:8080/v3/api-docs
