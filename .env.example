# Copy to repo-root `.env`. For Vite, copy VITE_* lines to `frontend/homepage/.env`.
# For Docker Compose DB creds, copy POSTGRES_* lines to `.env.docker`. Never commit real secrets.

# --- Required ---
OPENAI_API_KEY=
OPENAI_CHAT_ENABLED=true

# --- Docker Compose (`.env.docker`) ---
POSTGRES_PASSWORD=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# --- Production (Railway: AboutMe backend + resilient-emotion frontend) ---
# SPRING_PROFILES_ACTIVE=prod
# PORTFOLIO_JWT_SECRET=
# AI_BUDGET_ANON_SALT=
# Frontend service: BACKEND_URL=${{AboutMe.RAILWAY_PRIVATE_DOMAIN}}
# Backend uses watchPatterns; frontend rebuilds on every push. SKIPPED on backend-only is normal; use `railway redeploy --service <name>` if needed.

# --- Optional backend ---
# ANTHROPIC_API_KEY=
# PORTFOLIO_REALTIME_ENABLED=true
# ADMIN_BOOTSTRAP_USERNAME=
# ADMIN_BOOTSTRAP_PASSWORD=
# POSTHOG_ENABLED=false
# POSTHOG_API_KEY=
# POSTHOG_IDENTITY_SALT=aboutme-analytics-identity-v1
# Private PostHog API (feature-flag enable/disable for voice kill switch) — not the ingest host:
# POSTHOG_API_HOST=https://eu.posthog.com
# POSTHOG_PROJECT_ID=162788
# POSTHOG_PERSONAL_API_KEY=  # create at https://eu.posthog.com/settings/user-api-keys with feature_flag:read + feature_flag:write
# Railway (AboutMe service): already set POSTHOG_API_HOST + POSTHOG_PROJECT_ID; add the personal key with:
#   railway variables set POSTHOG_PERSONAL_API_KEY=phx_... --service AboutMe --skip-deploys

# --- Optional frontend (`frontend/homepage/.env`) ---
# VITE_POSTHOG_ENABLED=false
# VITE_POSTHOG_KEY=
