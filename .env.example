# Copy to `.env` in the repo root or `backend/`. Spring loads these via `spring.config.import`
# in backend/src/main/resources/application.yaml. Do not commit real values.

# --- Required (typical local dev: Compose Postgres on 5432) ---
# OpenAI: embeddings (text-embedding-3-large) / RAG; optional for default chat model.
OPENAI_API_KEY=
# Optional: Anthropic Claude in the chat UI; embeddings still use OpenAI above.
ANTHROPIC_API_KEY=
PORT=8080
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# --- Optional: JDBC (Compose backend uses db:5432) ---
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/aboutme

# --- Optional: Phoenix / OTLP (gRPC, often :4317) vs REST UI (often :6006) ---
# Host vs in-Compose URLs differ (e.g. localhost vs phoenix). In cloud, REST base URL and OTLP
# endpoint may need different hostnames; set PHOENIX_API_KEY for REST + OTLP when required.
# PHOENIX_OTLP_ENDPOINT=http://localhost:4317
# PHOENIX_BASE_URL=http://localhost:6006
# PHOENIX_API_KEY=

# --- Optional: PostHog (anonymous, consented frontend; optional backend LLM events) ---
# Use one project per deployment. Frontend: VITE_* ; backend: POSTHOG_* (see Spring config).
# VITE_POSTHOG_ENABLED=false
# VITE_POSTHOG_KEY=
# VITE_POSTHOG_HOST=https://eu.i.posthog.com
# POSTHOG_ENABLED=false
# POSTHOG_API_KEY=
# POSTHOG_HOST=https://eu.i.posthog.com

# --- Optional: default model when POST /ask omits "model" ---
# PORTFOLIO_CHAT_DEFAULT_MODEL_ID=gpt-5.4-mini

# --- Optional: first admin if username missing (remove password after login) ---
# ADMIN_BOOTSTRAP_USERNAME=
# ADMIN_BOOTSTRAP_PASSWORD=

# --- Optional: Orval `npm run api:pull` (not read by Spring) ---
# OPENAPI_URL=http://localhost:8080/v3/api-docs
