# Kopier til backend/.env og fyll inn. Ikke commit ekte nøkler.

# Prompts, RAG-maler og realtime-profil legges lokalt under backend/src/main/resources/
# (prompts/, templates/, realtime/) — se FILES.example og *.st.example der.

# Påkrevd for chat / RAG
OPENAI_API_KEY=
OPENAI_CHAT_ENABLED=true

# Database (standard i application.yaml holder lokalt uten disse)
