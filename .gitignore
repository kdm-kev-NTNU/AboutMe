# IDE
.idea/

# Cursor: share rules + mcp.json.example; ignore local MCP secrets and other machine state
.cursor/*
!.cursor/mcp.json.example
!.cursor/rules/
!.cursor/rules/**
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# Local environment (secrets / machine-specific)
.env
.env.*
**/.env
**/.env.*
!.env.example
!.env.docker.example
!frontend/homepage/.env.example
.env.docker

# Local credentials / private key material
**/credentials.json
**/secrets.json
**/*.key
**/*.pem
**/*.p12
**/*.pfx
**/id_rsa
**/id_ed25519

# Local vector store exports (not used by runtime)
backend/vectordatabase/

# Source documents for Chroma ingestion (personal data)
backend/data/*
!backend/data/docs/
backend/data/docs/*
!backend/data/docs/.gitkeep

# Maven build output
backend/target/

# Java class files (safety net outside target/)
*.class

# Maven wrapper JAR (auto-generated)
backend/.mvn/wrapper/maven-wrapper.jar

# Local scratch payloads / agent artifacts (never commit)
scripts/_*

# Local dependency tree dumps (ad-hoc mvn dependency:tree output)
backend/__deptree.txt

# Node/npm (any package root in the repo)
**/node_modules/
**/.pnpm-store/

# Frontend build/test output
frontend/homepage/dist/
frontend/homepage/dist-ssr/
frontend/homepage/.vite/
frontend/homepage/coverage/
frontend/homepage/test-results/
frontend/homepage/cypress/videos/
frontend/homepage/cypress/screenshots/
frontend/homepage/*.tsbuildinfo

# Docker local data volumes
docker-data/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local runtime/db/temp (DB patterns scoped to backend/ so committed test fixtures stay visible)
*.local
*.tmp
*.pid
backend/*.db
backend/*.sqlite
backend/*.sqlite3
backend/*.h2.db
