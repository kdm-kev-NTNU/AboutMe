# IDE
.idea/
/.vscode/
.cursor/

# Dependencies
node_modules/

# OS
.DS_Store
Thumbs.db

# Local environment (secrets / machine-specific)
.env
.env.*
!.env.example

# Local vector store exports (not used by runtime)
backend/vectordatabase/

# Source documents for Chroma ingestion (personal data)
backend/data/*
!backend/data/docs/
backend/data/docs/*
!backend/data/docs/.gitkeep

# Maven build output
backend/target/

# Local scratch payloads / agent artifacts (never commit)
scripts/_*

# Local dependency tree dumps (ad-hoc mvn dependency:tree output)
backend/__deptree.txt

# Frontend build/test output
frontend/homepage/dist/
frontend/homepage/dist-ssr/
frontend/homepage/coverage/
frontend/homepage/test-results/
frontend/homepage/cypress/videos/
frontend/homepage/cypress/screenshots/
frontend/homepage/*.tsbuildinfo

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local runtime/db/temp (DB patterns scoped to backend/ so committed test fixtures stay visible)
*.local
*.tmp
*.pid
backend/*.db
backend/*.sqlite
backend/*.sqlite3
backend/*.h2.db

# Proprietary prompts, templates, and knowledge base (personal / IP — supply locally)
backend/src/main/resources/prompts/*
!backend/src/main/resources/prompts/.gitkeep
!backend/src/main/resources/prompts/*.example
backend/src/main/resources/templates/*
!backend/src/main/resources/templates/.gitkeep
!backend/src/main/resources/templates/*.example
backend/src/main/resources/realtime/*
!backend/src/main/resources/realtime/.gitkeep
!backend/src/main/resources/realtime/*.example

# Local scratch (e.g. ad-hoc npm installs); never commit
tmp-npm-ci-check/
