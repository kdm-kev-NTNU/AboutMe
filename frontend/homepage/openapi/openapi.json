{
  "openapi": "3.0.3",
  "info": {
    "title": "AboutMe Portfolio API",
    "description": "REST API for the portfolio (RAG chat, auth, health, admin documents). SPA uses /api prefix via Vite or Nginx.",
    "version": "1.0.0"
  },
  "servers": [
    { "url": "http://localhost:8080", "description": "Direct backend" },
    { "url": "http://localhost:5173/api", "description": "Vite dev proxy" }
  ],
  "tags": [
    { "name": "Authentication", "description": "Login for SPA" },
    { "name": "Chat", "description": "RAG chat" },
    { "name": "Health", "description": "Ops health" },
    { "name": "Admin documents", "description": "ADMIN + HTTP Basic" },
    { "name": "Admin prompt versions", "description": "Versioned prompt management (ADMIN + HTTP Basic)" },
    { "name": "Feedback", "description": "Visitor feedback for improving the site" }
  ],
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic",
        "description": "Admin endpoints require ROLE_ADMIN"
      }
    },
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "required": ["username", "password"],
        "properties": {
          "username": { "type": "string" },
          "password": { "type": "string", "format": "password" }
        }
      },
      "LoginResponse": {
        "type": "object",
        "required": ["username", "role"],
        "properties": {
          "username": { "type": "string" },
          "role": { "type": "string", "enum": ["USER", "ADMIN"] }
        }
      },
      "FieldViolation": {
        "type": "object",
        "required": ["field", "message"],
        "properties": {
          "field": { "type": "string", "description": "Field or property path" },
          "message": { "type": "string", "description": "Validation message" }
        }
      },
      "ApiError": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": { "type": "string" },
          "code": {
            "type": "string",
            "description": "Machine-readable code when applicable (e.g. BUDGET_EXCEEDED, VALIDATION_FAILED, UNAUTHORIZED)."
          },
          "traceId": {
            "type": "string",
            "description": "Distributed trace id for correlating with server logs."
          },
          "timestamp": {
            "type": "string",
            "description": "ISO-8601 timestamp when the error was produced."
          },
          "violations": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/FieldViolation" },
            "description": "Field-level validation failures for HTTP 400 responses."
          }
        }
      },
      "ServiceUnavailableError": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": { "type": "string" }
        }
      },
      "TooManyRequestsError": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": { "type": "string" }
        }
      },
      "Question": {
        "type": "object",
        "required": ["question"],
        "properties": {
          "question": { "type": "string", "maxLength": 3000 },
          "model": { "type": "string", "description": "Allow-listed chat model id; omit for server default" }
        }
      },
      "FeedbackRequest": {
        "type": "object",
        "required": ["message"],
        "properties": {
          "message": { "type": "string", "maxLength": 4000, "description": "Feedback message" }
        }
      },
      "ChatModelOption": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "provider": { "$ref": "#/components/schemas/ChatModelOptionProvider" },
          "label": { "type": "string" },
          "tags": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ModelTag" }
          }
        }
      },
      "ModelTag": {
        "type": "string",
        "enum": ["FAST", "REASONING"]
      },
      "ChatModelOptionProvider": {
        "type": "string",
        "enum": ["OPENAI", "ANTHROPIC"]
      },
      "Answer": {
        "type": "object",
        "required": ["answer"],
        "properties": {
          "answer": { "type": "string" }
        }
      },
      "VectorStoreHealthResponse": {
        "type": "object",
        "properties": {
          "healthy": { "type": "boolean" },
          "collectionName": { "type": "string", "nullable": true },
          "embeddingCount": { "type": "integer", "format": "int64", "nullable": true },
          "message": { "type": "string", "nullable": true }
        }
      },
      "IngestionResult": {
        "type": "object",
        "properties": {
          "documentId": { "type": "string" },
          "filename": { "type": "string" },
          "chunksIngested": { "type": "integer", "format": "int32" },
          "skipped": { "type": "boolean" },
          "message": { "type": "string" }
        }
      },
      "DocumentListEntry": {
        "type": "object",
        "properties": {
          "documentId": { "type": "string" },
          "filename": { "type": "string" },
          "chunkCount": { "type": "integer", "format": "int32" },
          "lastIngestedAt": { "type": "string" }
        }
      },
      "VectorStoreCollectionEntry": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" }
        }
      },
      "VectorStoreInfoResponse": {
        "type": "object",
        "properties": {
          "activeCollectionName": { "type": "string" },
          "activeCollectionEmbeddingCount": { "type": "integer", "format": "int64", "nullable": true },
          "collections": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/VectorStoreCollectionEntry" }
          }
        }
      },
      "VectorStoreSyncResult": {
        "type": "object",
        "properties": {
          "rowsSynced": { "type": "integer", "format": "int64" },
          "durationMs": { "type": "integer", "format": "int64" },
          "sourceHostMasked": { "type": "string" },
          "truncatedLocalFirst": { "type": "boolean" }
        }
      },
      "ChunkItem": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "documentTitle": { "type": "string" },
          "chunkIndex": { "type": "integer", "format": "int32", "nullable": true },
          "text": { "type": "string" },
          "metadata": { "type": "object", "additionalProperties": true }
        }
      },
      "ChunkListResponse": {
        "type": "object",
        "properties": {
          "collectionName": { "type": "string" },
          "total": { "type": "integer", "format": "int64" },
          "totalMatching": { "type": "integer", "format": "int64" },
          "limit": { "type": "integer", "format": "int32" },
          "offset": { "type": "integer", "format": "int32" },
          "chunks": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ChunkItem" }
          }
        }
      },
      "ChunkExportResponse": {
        "type": "object",
        "properties": {
          "exportedAt": { "type": "string", "format": "date-time" },
          "collectionName": { "type": "string" },
          "documentId": { "type": "string", "nullable": true },
          "totalChunks": { "type": "integer", "format": "int64" },
          "chunks": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ChunkItem" }
          }
        }
      },
      "DefaultQuestionSuggestionRequest": {
        "type": "object",
        "required": ["source", "model"],
        "properties": {
          "source": {
            "type": "string",
            "description": "currentChunks or uploadedJson"
          },
          "documentId": { "type": "string", "nullable": true },
          "chunksJson": { "type": "string", "nullable": true },
          "model": { "type": "string" },
          "maxQuestions": { "type": "integer", "format": "int32", "nullable": true },
          "language": { "type": "string", "nullable": true }
        }
      },
      "DefaultQuestionSuggestionResponse": {
        "type": "object",
        "properties": {
          "suggestions": {
            "type": "array",
            "items": { "type": "string" }
          },
          "modelUsed": { "type": "string" }
        }
      },
      "PathIngestRequest": {
        "type": "object",
        "required": ["paths"],
        "properties": {
          "paths": {
            "type": "array",
            "items": { "type": "string" }
          },
          "force": { "type": "boolean", "default": false }
        }
      },
      "PromptNameEntry": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "language": { "type": "string", "nullable": true },
          "provider": { "type": "string", "nullable": true },
          "activeVersion": { "type": "integer", "format": "int32" },
          "activeId": { "type": "integer", "format": "int64" },
          "createdAt": { "type": "string", "nullable": true }
        }
      },
      "PromptVersionResponse": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "name": { "type": "string" },
          "version": { "type": "integer", "format": "int32" },
          "language": { "type": "string", "nullable": true },
          "provider": { "type": "string", "nullable": true },
          "content": { "type": "string" },
          "contentHash": { "type": "string" },
          "isActive": { "type": "boolean" },
          "description": { "type": "string", "nullable": true },
          "createdAt": { "type": "string", "nullable": true }
        }
      },
      "CreateVersionRequest": {
        "type": "object",
        "required": ["name", "content"],
        "properties": {
          "name": { "type": "string", "maxLength": 128 },
          "content": { "type": "string" },
          "language": { "type": "string", "maxLength": 8, "nullable": true },
          "provider": { "type": "string", "maxLength": 32, "nullable": true },
          "description": { "type": "string", "nullable": true }
        }
      },
      "ActivateRequest": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "integer", "format": "int64", "minimum": 1 }
        }
      },
      "DeleteVariantRequest": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "maxLength": 128 },
          "language": { "type": "string", "maxLength": 8, "nullable": true },
          "provider": { "type": "string", "maxLength": 32, "nullable": true }
        }
      },
      "PromptDiffResponse": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "language": { "type": "string", "nullable": true },
          "provider": { "type": "string", "nullable": true },
          "hasDbActive": { "type": "boolean" },
          "hasCodeFallback": { "type": "boolean" },
          "isEqual": { "type": "boolean" },
          "dbContent": { "type": "string", "nullable": true },
          "fallbackContent": { "type": "string", "nullable": true }
        }
      },
      "SeedResult": {
        "type": "object",
        "properties": {
          "created": { "type": "integer", "format": "int32" },
          "skipped": { "type": "integer", "format": "int32" },
          "total_fallbacks": { "type": "integer", "format": "int32" }
        }
      }
    }
  },
  "paths": {
    "/auth/login": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Login",
        "operationId": "authLogin",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LoginResponse" }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiError" }
              }
            }
          }
        }
      }
    },
    "/ask": {
      "post": {
        "tags": ["Chat"],
        "summary": "Ask a question",
        "operationId": "askQuestion",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Question" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Answer" }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiError" }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TooManyRequestsError" }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ServiceUnavailableError" }
              }
            }
          }
        }
      }
    },
    "/feedback": {
      "post": {
        "tags": ["Feedback"],
        "summary": "Submit feedback",
        "operationId": "submitFeedback",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/FeedbackRequest" }
            }
          }
        },
        "responses": {
          "204": { "description": "Feedback saved" },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiError" }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TooManyRequestsError" }
              }
            }
          }
        }
      }
    },
    "/chat/models": {
      "get": {
        "tags": ["Chat"],
        "summary": "List chat models",
        "operationId": "listChatModels",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/ChatModelOption" }
                }
              }
            }
          }
        }
      }
    },
    "/health/chroma": {
      "get": {
        "tags": ["Health"],
        "summary": "Vector store health (legacy /health/chroma)",
        "operationId": "healthChroma",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/VectorStoreHealthResponse" }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/VectorStoreHealthResponse" }
              }
            }
          }
        }
      }
    },
    "/admin/tools/documents/upload": {
      "post": {
        "tags": ["Admin documents"],
        "summary": "Upload and ingest",
        "operationId": "adminDocumentsUpload",
        "security": [{ "basicAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["file"],
                "properties": {
                  "file": { "type": "string", "format": "binary" },
                  "title": { "type": "string" },
                  "force": { "type": "boolean", "default": false }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/IngestionResult" }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/IngestionResult" }
              }
            }
          }
        }
      }
    },
    "/admin/tools/documents/upload/batch": {
      "post": {
        "tags": ["Admin documents"],
        "summary": "Upload and ingest multiple documents",
        "operationId": "adminDocumentsUploadBatch",
        "security": [{ "basicAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["files"],
                "properties": {
                  "files": {
                    "type": "array",
                    "items": { "type": "string", "format": "binary" }
                  },
                  "force": { "type": "boolean", "default": false }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/IngestionResult" }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/IngestionResult" }
                }
              }
            }
          }
        }
      }
    },
    "/admin/tools/documents/ingest-by-path": {
      "post": {
        "tags": ["Admin documents"],
        "summary": "Ingest documents by path relative to documentsToLoadDir",
        "operationId": "adminDocumentsIngestByPath",
        "security": [{ "basicAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PathIngestRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/IngestionResult" }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/IngestionResult" }
                }
              }
            }
          }
        }
      }
    },
    "/admin/tools/documents/files": {
      "get": {
        "tags": ["Admin documents"],
        "summary": "List files under documentsToLoadDir",
        "description": "Relative paths with supported extensions under sfg.aiapp.documentsToLoadDir (file: URLs only).",
        "operationId": "adminDocumentsFiles",
        "security": [{ "basicAuth": [] }],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "/admin/tools/documents": {
      "get": {
        "tags": ["Admin documents"],
        "summary": "List documents",
        "operationId": "adminDocumentsList",
        "security": [{ "basicAuth": [] }],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/DocumentListEntry" }
                }
              }
            }
          }
        }
      }
    },
    "/admin/tools/documents/chunks/export": {
      "get": {
        "tags": ["Admin documents"],
        "summary": "Export all chunks in the active collection",
        "operationId": "adminDocumentsChunksExport",
        "security": [{ "basicAuth": [] }],
        "parameters": [
          {
            "name": "documentId",
            "in": "query",
            "required": false,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ChunkExportResponse" }
              }
            }
          }
        }
      }
    },
    "/admin/tools/documents/chunks": {
      "get": {
        "tags": ["Admin documents"],
        "summary": "List chunks in the active collection",
        "operationId": "adminDocumentsChunks",
        "security": [{ "basicAuth": [] }],
        "parameters": [
          {
            "name": "documentId",
            "in": "query",
            "required": false,
            "schema": { "type": "string" }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "format": "int32", "default": 25 }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "format": "int32", "default": 0 }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ChunkListResponse" }
              }
            }
          }
        }
      }
    },
    "/admin/tools/documents/question-suggestions": {
      "post": {
        "tags": ["Admin documents"],
        "summary": "Suggest default chatbot starter questions from chunks",
        "operationId": "adminDocumentsQuestionSuggestions",
        "security": [{ "basicAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/DefaultQuestionSuggestionRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DefaultQuestionSuggestionResponse" }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiError" }
              }
            }
          }
        }
      }
    },
    "/admin/tools/documents/collections": {
      "get": {
        "tags": ["Admin documents"],
        "summary": "List vector store (pgvector table summary)",
        "operationId": "adminDocumentsCollections",
        "security": [{ "basicAuth": [] }],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/VectorStoreInfoResponse" }
              }
            }
          }
        }
      }
    },
    "/admin/tools/documents/reseed": {
      "post": {
        "tags": ["Admin documents"],
        "summary": "Re-seed classpath documents",
        "operationId": "adminDocumentsReseed",
        "security": [{ "basicAuth": [] }],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/IngestionResult" }
                }
              }
            }
          }
        }
      }
    },
    "/admin/tools/documents/sync-from-remote": {
      "post": {
        "tags": ["Admin documents"],
        "summary": "Sync vector_store from remote Postgres into local DB",
        "operationId": "adminDocumentsSyncFromRemote",
        "security": [{ "basicAuth": [] }],
        "parameters": [
          {
            "name": "clean",
            "in": "query",
            "required": false,
            "schema": { "type": "boolean", "default": false },
            "description": "When true, TRUNCATE local vector_store before upsert"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/VectorStoreSyncResult" }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiError" }
              }
            }
          },
          "403": { "description": "Sync disabled" }
        }
      }
    },
    "/admin/tools/documents/{documentId}": {
      "delete": {
        "tags": ["Admin documents"],
        "summary": "Delete document",
        "operationId": "adminDocumentsDelete",
        "security": [{ "basicAuth": [] }],
