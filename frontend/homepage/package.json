{
  "name": "homepage",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "prepare": "node -e \"if(!process.env.CI)try{require.resolve('cypress');require('child_process').execSync('cypress install',{stdio:'inherit'})}catch(_){}\"",
    "test:e2e": "start-server-and-test preview http://localhost:4173 'cypress run --e2e'",
    "test:e2e:dev": "start-server-and-test 'vite dev --port 4173' http://localhost:4173 'cypress open --e2e'",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "api:pull": "node scripts/fetch-openapi.mjs",
    "api:generate": "orval --config orval.config.ts",
    "lint": "eslint . --fix",
    "lint:ci": "eslint . --max-warnings 0",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "@vueuse/core": "^14.2.1",
    "@vueuse/motion": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.2.6",
    "lucide": "^1.11.0",
    "lucide-vue-next": "^0.544.0",
    "markdown-it": "^14.1.0",
    "pinia": "^3.0.3",
    "posthog-js": "^1.369.3",
    "reka-ui": "^2.5.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.2.4",
    "tw-animate-css": "^1.3.8",
    "vue": "^3.5.18",
    "vue-router": "^5.0.6"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.5",
    "@types/jsdom": "^21.1.7",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.6.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitejs/plugin-vue-jsx": "^5.1.5",
    "@vitest/coverage-v8": "^4.1.5",
    "@vitest/eslint-plugin": "^1.3.4",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.1",
    "cypress": "^15.14.1",
    "eslint": "^10.2.1",
    "eslint-plugin-cypress": "^6.3.1",
    "eslint-plugin-vue": "~10.9.0",
    "jiti": "^2.4.2",
    "jsdom": "^26.1.0",
    "npm-run-all2": "^8.0.4",
    "orval": "^7.21.0",
    "prettier": "3.8.3",
    "start-server-and-test": "^3.0.2",
    "typescript": "~5.8.0",
    "vite": "^8.0.10",
    "vite-plugin-vue-devtools": "^8.1.1",
    "vitest": "^4.1.5",
    "vue-tsc": "^3.0.4"
  },
  "overrides": {
    "uuid": "^14.0.0",
    "vite-plugin-inspect": "12.0.0-beta.1"
  }
}
