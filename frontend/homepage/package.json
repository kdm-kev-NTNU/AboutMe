{
  "name": "homepage",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": "^20.19.0 || >=22.22.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "prepare": "node -e \"if(!process.env.CI)try{require.resolve('cypress');require('child_process').execSync('cypress install',{stdio:'inherit'})}catch(_){}\"",
    "test:e2e": "start-server-and-test preview http://localhost:4173 'cypress run --e2e'",
    "test:e2e:dev": "start-server-and-test 'vite dev --port 4173' http://localhost:4173 'cypress open --e2e'",
    "test:e2e:voice-live": "cypress run --e2e --spec cypress/e2e/voice-live-smoke.cy.ts --env VOICE_LIVE=true,VOICE_LIVE_EXPECT_REALTIME_ENABLED=true",
    "test:e2e:voice-live:openai": "cypress run --e2e --spec cypress/e2e/voice-live-smoke.cy.ts --env VOICE_LIVE=true,VOICE_LIVE_EXPECT_REALTIME_ENABLED=true,VOICE_LIVE_RUN_OPENAI=true",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "api:generate": "npx --no-install orval --config orval.config.ts",
    "lint": "eslint . --fix",
    "lint:ci": "eslint . --max-warnings 0",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vueuse/core": "^14.4.0",
    "@vueuse/motion": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.14",
    "gsap": "^3.15.0",
    "lucide-vue-next": "^1.0.0",
    "markdown-it": "^15.0.1",
    "pinia": "^4.0.3",
    "posthog-js": "^1.425.1",
    "reka-ui": "^2.10.4",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.3.8",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.6",
    "@types/jsdom": "^30.0.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.4.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "cypress": "^16.0.0",
    "eslint": "^10.9.1",
    "eslint-plugin-cypress": "^7.0.1",
    "eslint-plugin-vue": "~10.10.0",
    "jiti": "^2.4.2",
    "jsdom": "^30.0.1",
    "npm-run-all2": "^9.0.3",
    "orval": "^8.27.0",
    "prettier": "3.9.6",
    "start-server-and-test": "^3.0.11",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.11"
  },
  "overrides": {
    "uuid": "^14.0.0",
    "qs": "^6.15.2",
    "js-cookie": "^3.0.7",
    "systeminformation": "^5.31.17",
    "vite-plugin-inspect": "12.0.0-beta.1",
    "axios": "^1.19.0",
    "form-data": "^4.0.6",
    "undici": "^7.28.0",
    "shell-quote": "^1.10.0",
    "fast-uri": "^3.1.5",
    "postcss": "^8.5.25",
    "linkify-it": "^5.0.2"
  }
}
