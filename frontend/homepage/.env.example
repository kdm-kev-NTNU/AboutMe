# Frontend build-time values (Vite). Copy to frontend/homepage/.env — do not commit real keys.
# Backend secrets belong in repo-root .env — see ../../.env.example

# PostHog browser analytics (opt-in after cookie consent)
VITE_POSTHOG_ENABLED=false
VITE_POSTHOG_KEY=
# Optional; defaults to https://eu.i.posthog.com
# VITE_POSTHOG_HOST=https://eu.i.posthog.com

# Dev only: override API proxy target when running Vite outside Docker (default http://localhost:8080)
# VITE_API_PROXY_TARGET=http://localhost:8080
